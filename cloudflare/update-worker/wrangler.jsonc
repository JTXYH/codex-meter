{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "codex-meter-updates",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "GITHUB_OWNER": "JTXYH",
    "GITHUB_REPO": "codex-meter",
    "ASSET_PREFIX": "CodexMeter-"
  },
  "ratelimits": [
    {
      "name": "UPDATE_RATE_LIMITER",
      "namespace_id": "827431",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
